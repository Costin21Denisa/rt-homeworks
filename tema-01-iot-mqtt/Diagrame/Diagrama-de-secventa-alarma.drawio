        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;sequenceDiagram\n    autonumber\n    participant Sensor as TemperatureSensor\n    participant Periodic as PeriodicTelemetryTask\n    participant Q as alarmEvents\n    participant Alarm as SporadicAlarmTask\n    participant Broker as MQTT Broker\n    participant Processor as MessageProcessor\n    participant CSV as CsvStorage\n    participant Dashboard\n\n    Periodic-&gt;&gt;Sensor: read()\n    Sensor--&gt;&gt;Periodic: temperatura = 30.13 °C\n    Periodic-&gt;&gt;Broker: publish telemetry\n    Broker--&gt;&gt;Processor: mesaj telemetry\n    Processor-&gt;&gt;CSV: append telemetry\n    Processor-&gt;&gt;Dashboard: updateTelemetry\n\n    alt temperatura depășește pragul\n        Periodic-&gt;&gt;Q: offer(30.13)\n        Alarm-&gt;&gt;Q: take()\n        Q--&gt;&gt;Alarm: eveniment alarmă\n\n        alt intervalul minim de 5000 ms este respectat\n            Alarm-&gt;&gt;Broker: publish alarm (...;30.13;28.00)\n            Broker--&gt;&gt;Processor: mesaj alarm\n            Processor-&gt;&gt;CSV: append alarm\n            Processor-&gt;&gt;Dashboard: updateAlarm și incrementare contor\n            Processor--&gt;&gt;Processor: afișează [ALARM]\n        else evenimentul sosește prea devreme\n            Alarm--&gt;&gt;Alarm: respinge evenimentul\n        end\n    end&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="5A585X4-5S9p9eGp3xGD-1">
